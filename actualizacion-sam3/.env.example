# URL del backend (módulo web) al que se le envían los resultados de conteo
BACKEND_API_URL=http://localhost:3000/api/conteo

# Token compartido con el backend (debe coincidir con VISION_API_TOKEN del .env del módulo web)
VISION_API_TOKEN=cambia_esto_tambien

# Fuente de video/imágenes: puede ser
#   - Carpeta de fotos:    ./fotos_prueba
#   - Video ya grabado:    ./videos_prueba/muestra_poza_1.mp4
#   - Cámara IP en vivo:   rtsp://192.168.1.50/stream  (cuando MACROMEC la facilite)
VIDEO_SOURCE=./fotos_prueba

# --- Modo de detección ---
# "simulado" = número aleatorio (por defecto, sin credenciales necesarias)
# "sam3"     = modelo SAM3 vía Roboflow, sin entrenamiento propio (recomendado por ahora)
# "yolo"     = modelo YOLOv8 propio ya entrenado
MODO_DETECCION=simulado

# --- Configuración para MODO_DETECCION=sam3 ---
ROBOFLOW_API_KEY=
ROBOFLOW_WORKFLOW_URL=https://serverless.roboflow.com/willy-urzch/workflows/carrot-sack-counter
ROBOFLOW_CONFIDENCE=0.3
# Nota: el texto descriptivo ("orange mesh bag") NO se configura aquí —
# ya quedó guardado dentro del workflow en la interfaz de Roboflow.

# --- Configuración para MODO_DETECCION=yolo ---
RUTA_MODELO_YOLO=modelos/best.pt
