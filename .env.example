# URL del backend (módulo web) al que se le envían los resultados de conteo
BACKEND_API_URL=http://localhost:3000/api/conteo

# Token compartido con el backend (debe coincidir con VISION_API_TOKEN del .env del módulo web)
VISION_API_TOKEN=cambia_esto_tambien

# Fuente de video/imágenes: puede ser
#   - Carpeta de fotos:    ./fotos_prueba
#   - Video ya grabado:    ./videos_prueba/muestra_poza_1.mp4
#   - Cámara IP en vivo:   rtsp://192.168.1.50/stream  (cuando MACROMEC la facilite)
VIDEO_SOURCE=./fotos_prueba
